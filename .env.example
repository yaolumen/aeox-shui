# ========================================
# Quantum Fate Lite · Environment Variables
# ========================================
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# ⚠️ NEVER commit .env to Git (already in .gitignore)
# ⚠️ NEVER paste real keys into .env.example (this file IS committed)

# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Quantum Fate Lite
NEXT_PUBLIC_SITE_LOCALE=en

# ===== Database =====
# Override the SQLite data directory (default: ./data relative to cwd)
# Useful on Hostinger VPS if cwd differs from app root
# DATABASE_DIR=/home/<user>/domains/<your-domain>/public_html/quantum-fate-lite/data

# ===== AI Providers (OpenAI-compatible) =====

# Agnes AI — Omni-modal API, OpenAI-compatible
# Get a key at: https://agnes-ai.com
AGNES_AI_API_KEY=replace-me-with-your-agnes-key
AGNES_AI_BASE_URL=https://apihub.agnes-ai.com/v1
# Models: agnes-2.0-flash (fast), agnes-2.5-flash (improved), agnes-2.5-pro (reasoning)
AGNES_AI_MODEL=agnes-2.0-flash

# UnoRouter — Unified gateway, 200+ models, free tier available
# Get a key at: https://unorouter.com
UNOROUTER_API_KEY=replace-me-with-your-unorouter-key
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
# Models: gpt-oss-120b:free, deepseek-v4-flash:free, glm-4-flash:free, etc.
UNOROUTER_MODEL=gpt-oss-120b:free

# Zhipu GLM-4-Flash (great for Chinese, free tier)
# Get a key at: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=replace-me-with-your-zhipu-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# NVIDIA NIM (free tier, multi-model, must start with nvapi-)
# Get a key at: https://build.nvidia.com/explore/discover
NVIDIA_NIM_API_KEY=replace-me-with-your-nvapi-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Models: meta/llama-3.1-8b-instruct, meta/llama-3.1-70b-instruct, meta/llama-3.3-70b-instruct
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# ===== Admin =====
# Password for the admin page. Must be >= 6 chars in production.
ADMIN_PASSWORD=change_me_in_production
# Custom admin URL slug (default: admingl). Access admin at /{ADMIN_SLUG}
# Changing this after deployment will invalidate bookmarked admin URLs.
# Use a hard-to-guess value to avoid automated scanning of /admin.
ADMIN_SLUG=admingl

# ===== Default Reference Classic =====
# sanming         = San Ming Tong Hui (三命通会)
# zipingzhenquan  = Zi Ping Zhen Quan (子平真诠)
FATE_BOOK_DEFAULT=sanming

# ===== Misc =====
# NODE_ENV is set by PM2/ecosystem.config.cjs — do NOT set it here
# or it will override the production setting on deploy
